<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>

<AnchorPane prefHeight="400.0"
            prefWidth="600.0"
            styleClass="mainFxmlClass"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.calculadoramini.controller.interfaces.ControllerInterface">

    <stylesheets>
        <URL value="@/styles/interfaceCalculadora.css"/>
    </stylesheets>

    <children>

        <Label text="Calculadora Mini"
               alignment="CENTER"
               styleClass="title-label"
               AnchorPane.topAnchor="40.0"
               AnchorPane.leftAnchor="100.0"
               AnchorPane.rightAnchor="100.0"/>

        <TextField fx:id="txtNumero1"
                   promptText="Primer número"
                   styleClass="minimal-text-field"
                   AnchorPane.topAnchor="110.0"
                   AnchorPane.leftAnchor="150.0"
                   AnchorPane.rightAnchor="150.0"/>

        <TextField fx:id="txtNumero2"
                   promptText="Segundo número"
                   styleClass="minimal-text-field"
                   AnchorPane.topAnchor="170.0"
                   AnchorPane.leftAnchor="150.0"
                   AnchorPane.rightAnchor="150.0"/>

        <HBox spacing="10"
              alignment="CENTER"
              AnchorPane.topAnchor="240.0"
              AnchorPane.leftAnchor="100.0"
              AnchorPane.rightAnchor="100.0">

            <Button text="+"
                    onAction="#handleSumar"
                    styleClass="minimal-button"/>

            <Button text="-"
                    onAction="#handleRestar"
                    styleClass="minimal-button"/>

            <Button text="×"
                    onAction="#handleMultiplicar"
                    styleClass="minimal-button"/>

            <Button text="÷"
                    onAction="#handleDividir"
                    styleClass="minimal-button"/>

        </HBox>

        <Label fx:id="lblResultado"
               text="—"
               alignment="CENTER"
               styleClass="result-label"
               AnchorPane.topAnchor="320.0"
               AnchorPane.leftAnchor="100.0"
               AnchorPane.rightAnchor="100.0"/>

    </children>

</AnchorPane>
