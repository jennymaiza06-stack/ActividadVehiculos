<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<AnchorPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ec.edu.espoch.interfacesdos.CalculadoraController"
            stylesheets="@usuario.css"
            prefWidth="450"
            prefHeight="650">

    <children>

        <VBox alignment="CENTER" spacing="20"
              prefWidth="450"
              prefHeight="650"
              styleClass="contenedor">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <TextField fx:id="txtPantalla"
                       text="0"
                       editable="false"
                       styleClass="pantalla"/>

            <GridPane hgap="12" vgap="12">

                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="25"/>
                </columnConstraints>

                <rowConstraints>
                    <RowConstraints prefHeight="80"/>
                    <RowConstraints prefHeight="80"/>
                    <RowConstraints prefHeight="80"/>
                    <RowConstraints prefHeight="80"/>
                    <RowConstraints prefHeight="80"/>
                </rowConstraints>

                <!-- FILA 1 -->

                <Button text="C"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="0"
                        styleClass="btnRojo"
                        onAction="#limpiar"/>

                <Button text="%"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="1"
                        styleClass="btnMorado"/>

                <Button text="⌫"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="2"
                        styleClass="btnMorado"/>

                <Button text="÷"
                        GridPane.rowIndex="0"
                        GridPane.columnIndex="3"
                        styleClass="btnOperacion"
                        onAction="#operador"/>

                <!-- FILA 2 -->

                <Button text="7"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="0"
                        styleClass="btnNumero"
                        onAction="#escribir"/>

                <Button text="8"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="1"
                        styleClass="btnNumero"
                        onAction="#escribir"/>

                <Button text="9"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="2"
                        styleClass="btnNumero"
                        onAction="#escribir"/>

                <Button text="×"
                        GridPane.rowIndex="1"
                        GridPane.columnIndex="3"
                        styleClass="btnOperacion"
                        onAction="#operador"/>

                <!-- FILA 3 -->

                <Button text="4"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="0"
                        styleClass="btnNumero"
                        onAction="#escribir"/>

                <Button text="5"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="1"
                        styleClass="btnNumero"
                        onAction="#escribir"/>

                <Button text="6"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="2"
                        styleClass="btnNumero"
                        onAction="#escribir"/>

                <Button text="-"
                        GridPane.rowIndex="2"
                        GridPane.columnIndex="3"
                        styleClass="btnOperacion"
                        onAction="#operador"/>

                <!-- FILA 4 -->

                <Button text="1"
                        GridPane.rowIndex="3"
                        GridPane.columnIndex="0"
                        styleClass="btnNumero"
                        onAction="#escribir"/>

                <Button text="2"
                        GridPane.rowIndex="3"
                        GridPane.columnIndex="1"
                        styleClass="btnNumero"
                        onAction="#escribir"/>

                <Button text="3"
                        GridPane.rowIndex="3"
                        GridPane.columnIndex="2"
                        styleClass="btnNumero"
                        onAction="#escribir"/>

                <Button text="+"
                        GridPane.rowIndex="3"
                        GridPane.columnIndex="3"
                        styleClass="btnOperacion"
                        onAction="#operador"/>

                <!-- FILA 5 -->

                <Button text="0"
                        GridPane.rowIndex="4"
                        GridPane.columnIndex="0"
                        GridPane.columnSpan="2"
                        maxWidth="1000"
                        styleClass="btnNumero"
                        onAction="#escribir"/>

                <Button text="."
                        GridPane.rowIndex="4"
                        GridPane.columnIndex="2"
                        styleClass="btnNumero"
                        onAction="#escribir"/>

                <Button text="="
                        GridPane.rowIndex="4"
                        GridPane.columnIndex="3"
                        styleClass="btnIgual"
                        onAction="#igual"/>

            </GridPane>

        </VBox>

    </children>

</AnchorPane>